# Optional command overrides for local agent providers.
OPENCODE_BIN=opencode
HERMES_BIN=hermes
# Provider authenticated in Hermes (hermes auth status <provider>).
HERMES_PROVIDER=openai-codex
# Maximum time allowed for the browser-based OpenAI login flow.
OPENCODE_AUTH_TIMEOUT_MS=300000
# Maximum time allowed for an agent execution before it is failed and cleaned up.
AGENT_EXECUTION_TIMEOUT_MS=900000
